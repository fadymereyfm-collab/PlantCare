<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night: everything comes from Base.Theme.PlantCareApp (values/themes.xml)
         with values-night/colors.xml; only the system-bar icon flags and the
         plain (pattern-free) window background differ. -->
