<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare — Phase G0.4: Decorative leaf texture overlay.
    Used inside bg_screen_root layer-list at 7% opacity.
    Pure vector — no raster, no GPU cost.

    Eight scattered leaves of varying sizes, distributed to mimic the
    "botanical wallpaper" feel of the reference Plant Identifier app.
    The viewBox is 360×800 (typical phone aspect ratio); when stretched
    to fill via android:gravity="fill" the leaves land proportionally
    in the four corners + mid-edges on any device.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="360dp"
    android:height="800dp"
    android:viewportWidth="360"
    android:viewportHeight="800"
    android:alpha="0.07">

    <!-- ── Top-right cluster ───────────────────────────────── -->
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M295,45 C325,30 355,55 348,95 C340,130 295,148 275,115 C262,90 270,60 295,45 Z" />
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M335,140 C355,135 370,155 360,180 C350,200 320,205 310,180 C302,160 318,145 335,140 Z" />

    <!-- ── Mid-left ────────────────────────────────────────── -->
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M-10,280 C25,265 60,290 55,335 C48,375 5,395 -15,360 C-30,335 -25,295 -10,280 Z" />
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M40,380 C58,372 75,385 72,410 C68,432 42,442 30,422 C22,408 28,388 40,380 Z" />

    <!-- ── Mid-right ───────────────────────────────────────── -->
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M345,420 C370,410 388,432 380,462 C372,488 340,498 325,475 C312,455 325,430 345,420 Z" />

    <!-- ── Bottom-left ─────────────────────────────────────── -->
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M40,680 C72,665 105,690 98,735 C92,775 45,795 22,762 C7,738 18,695 40,680 Z" />

    <!-- ── Bottom-right ────────────────────────────────────── -->
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M310,720 C342,705 372,732 362,775 C354,815 308,830 290,795 C275,768 290,732 310,720 Z" />

    <!-- ── Centerpiece (very subtle, large) ────────────────── -->
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M150,540 C175,530 200,555 192,585 C185,612 152,622 138,597 C128,580 138,548 150,540 Z" />

</vector>
