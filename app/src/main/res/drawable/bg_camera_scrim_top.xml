<!--
    PlantCare — Camera top scrim (F2.3).
    Vertical gradient: opaque-ish black at top fading to fully transparent
    at the bottom. Sits over the camera preview to make the close button
    + hint text legible against any background the preview is showing.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#99000000"
        android:endColor="#00000000" />
</shape>
