<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare G7 - Settings row icon tile.
    Soft outlined disc that frames every Settings glyph (Contact us,
    Rate us, Share app, ...). Matches the reference Plant Identifier
    Settings rows where each icon sits inside a subtle ring.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/pc_background_dim" />
    <stroke
        android:width="1dp"
        android:color="@color/pc_outlineVariant" />
</shape>
