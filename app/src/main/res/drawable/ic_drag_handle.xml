<!--
  Drag-handle affordance shown at the right edge of every room row in
  MyPlantsFragment. Touch+drag on this icon initiates a reorder via
  ItemTouchHelper.startDrag while the user's finger is still down,
  which is the only reliable way to drive a programmatic drag — the
  prior "long-press → menu → Verschieben" flow tried to call startDrag
  after the touch had already lifted, so the drag activated and ended
  silently in the same frame.

  Three horizontal bars: standard reorder glyph (Material Symbols
  "drag_handle").
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/pc_onSurfaceSecondary"
        android:pathData="M3,8 L21,8 L21,10 L3,10 Z M3,14 L21,14 L21,16 L3,16 Z" />
</vector>
