<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare - Phase G0.2 - Inter font family.
    Production wiring: points at the real Inter Regular + SemiBold TTFs
    that Fady dropped into res/font/ on 2026-05-16. Used for ALL body and
    button text via TextAppearance.PlantCare.Body + .Button.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/inter_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/inter_semibold" />
</font-family>
