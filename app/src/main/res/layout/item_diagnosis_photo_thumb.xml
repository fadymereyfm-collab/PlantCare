<?xml version="1.0" encoding="utf-8"?>
<!--
    2026-05-20 Feature 2 (Multi-image): single thumbnail in the
    DiseaseDiagnosisActivity photo strip. Square 72dp tile with a
    rounded corner clip, the photo filling it via centerCrop, and a
    floating "×" badge in the top-right that fires a remove callback.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/pc_outlineVariant"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/pc_surface">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/thumbImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/plant_image" />

        <!-- × remove button: small circular badge in the top-right corner.
             foregroundless ImageView keeps the tap target the same size as
             the visual circle (24dp). -->
        <ImageView
            android:id="@+id/thumbRemove"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="2dp"
            android:background="@drawable/bg_thumb_remove"
            android:src="@drawable/ic_close"
            android:padding="4dp"
            android:contentDescription="@string/disease_photo_remove"
            app:tint="@color/pc_onPrimary"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
