<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare — item_daily_watering (F4.1 — visual redesign)

    Row used in TodayFragment's RecyclerView (and any other watering-
    grouped list). Image-led card layout:

      ┌─────────────────────────────────────────────────────┐
      │ ▌ [photo]   Plant name              [type icon]     │
      │ ▌           12. Mai • +2 Tage                       │
      └─────────────────────────────────────────────────────┘
        ↑
        sideStripe (4dp, indicates done/pending state)

    All IDs preserved so DailyWateringAdapter's ReminderViewHolder
    binding continues to work unchanged: sideStripe, imagePlantThumb,
    textPlantName, textDueDate, textOverdue, imageTypeIcon.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/pc_surface"
    app:strokeColor="@color/pc_outlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="80dp">

        <!-- Side stripe: F4.1 — narrower (4dp) and full-height. Bound to a
             tonal color from DailyWateringAdapter to convey done/pending. -->
        <View
            android:id="@+id/sideStripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/pc_success" />

        <!-- Plant photo — rounded square 56dp. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imagePlantThumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_plant"
            android:background="@color/pc_secondaryContainer"
            android:contentDescription="@string/plant_image"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PlantCare.RoundedSquare" />

        <!-- Text block: plant name on top, date + overdue on bottom. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/textPlantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.PlantCare.Subtitle"
                android:textSize="15sp"
                tools:text="Monstera Deliciosa" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/textDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PlantCare.BodySmall"
                    tools:text="12. Mai" />

                <TextView
                    android:id="@+id/textOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/pc_error"
                    android:visibility="gone"
                    tools:text="+1"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Type icon — sits inside a soft circle chip on the trailing edge. -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_chip_circle_soft">

            <ImageView
                android:id="@+id/imageTypeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_water_drop"
                app:tint="@color/pc_primary"
                android:contentDescription="@string/water_plant" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
