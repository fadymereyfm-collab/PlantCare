<?xml version="1.0" encoding="utf-8"?>
<!--
  الحوار الابتدائي للمصادقة:
  - يحتوي زرّي Google والبريد الإلكتروني فقط (تم إزالة Apple + Magic Link
    في جلسة 2026-05-13 لأنهما غير مدعومين على Android المخصّص للعميل
    الألماني وبسبب اعتماد Magic Link على Firebase Dynamic Links غير
    مكوّن في Firebase Console للمشروع الحالي).
  - AuthStartDialogFragment يعتمد فقط على المعرّفات:
      btnGoogle, btnEmail, buttonToggleMode, buttonClose
  - العرض النهائي يُضبط إلى 90% في الكود (onStart) وليس هنا.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- العنوان + زر الإغلاق -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/textAuthTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/welcome"
                    android:textAppearance="@style/TextAppearance.PlantCare.Headline"
                    android:textSize="22sp" />

                <ImageButton
                    android:id="@+id/buttonClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/pc_onSurfaceSecondary"
                    android:padding="10dp"
                    android:contentDescription="@string/close"/>
            </LinearLayout>

            <!-- زر Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/PlantCare.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/auth_button_google_login"
                android:layout_marginBottom="12dp" />

            <!-- زر البريد — النص يتبدّل بين تسجيل/إنشاء حسب وضع الفتح -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmail"
                style="@style/PlantCare.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/auth_button_email_continue"
                android:layout_marginBottom="12dp" />

            <!-- التبديل بين Register / Login — كان TextView صغير ومختلف الشكل
                 عن الأزرار، أصبح MaterialButton.Text كامل العرض لتوحيد المظهر. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToggleMode"
                style="@style/PlantCare.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/auth_toggle_to_login"
                android:textAllCaps="false" />

            <!-- Phase 1.1: progress while Google round-trip -->
            <ProgressBar
                android:id="@+id/authStartProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Phase 1.2: inline error replaces Toast -->
            <TextView
                android:id="@+id/authStartError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pc_error"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
