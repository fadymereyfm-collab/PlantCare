<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare — ImagePostCaptureBottomSheet layout (2026-05-20 Feature 1)

    Shown after the user captures a photo or picks one from the gallery
    inside UnifiedCameraActivity. Two routes:

      1. "Zuschneiden"   → launches uCrop on the captured file
      2. "So verwenden"  → routes the original file straight to Identify/Diagnose

    Hosted in BottomSheetDialogFragment so it inherits the
    BottomSheetStyle.Modern surface + 28dp top corners from themes.xml.
    Layout mirrors sheet_add_plant_choice.xml for visual consistency.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crop_sheet_title"
        android:textAppearance="@style/TextAppearance.PlantCare.Title"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crop_sheet_subtitle"
        android:textAppearance="@style/TextAppearance.PlantCare.BodySmall"
        android:layout_marginBottom="16dp" />

    <!-- Option 1: Crop -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionCrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/pc_outlineVariant"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/pc_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:background="@color/pc_secondaryContainer"
                android:padding="8dp"
                android:src="@drawable/ic_crop"
                android:contentDescription="@null"
                app:tint="@color/pc_onSecondaryContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/crop_sheet_action_crop"
                android:textAppearance="@style/TextAppearance.PlantCare.Subtitle" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Option 2: Use as is (skip) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionSkip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/pc_outlineVariant"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/pc_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:background="@color/pc_secondaryContainer"
                android:padding="8dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                app:tint="@color/pc_onSecondaryContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/crop_sheet_action_skip"
                android:textAppearance="@style/TextAppearance.PlantCare.Subtitle" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cancel button — returns to camera preview without routing -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCancel"
        style="@style/PlantCare.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crop_sheet_action_cancel" />

</LinearLayout>
