<?xml version="1.0" encoding="utf-8"?>
<!-- Pending invitation row: title + body + Accept/Decline buttons. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/pc_surface"
    app:strokeColor="@color/pc_outlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/pendingInviteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pc_onSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Maria möchte „Aloe“ mit dir teilen"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/pendingInviteSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/pc_onSurfaceSecondary"
            android:textSize="13sp"
            tools:text="maria@example.com"
            xmlns:tools="http://schemas.android.com/tools" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pendingInviteDecline"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_invite_dialog_decline"
                android:textColor="@color/pc_onSurfaceSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pendingInviteAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/share_invite_dialog_accept" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
