<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare — item_plant_in_room (F4.2)

    LEGACY / orphan: confirmed unused by grep — PlantsInRoomActivity
    binds the shared `item_plant.xml` via `PlantAdapter`. Kept on disk
    as the codebase still ships an inflated reference in some old code
    paths; refreshed visually so an accidental re-binding doesn't show
    pre-F2 chrome.

    Safe to delete manually in a future cleanup pass (sandbox cannot
    delete in this session).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/pc_surface"
    app:strokeColor="@color/pc_outlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textPlantInRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PlantCare.Subtitle"
            tools:text="Aloe Vera" />

        <TextView
            android:id="@+id/textPersonalNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PlantCare.BodySmall"
            android:textStyle="italic"
            android:visibility="gone"
            android:layout_marginTop="3dp"
            tools:text="Im Wohnzimmer am Fenster" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
