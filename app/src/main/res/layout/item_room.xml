<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/pc_surface"
    app:rippleColor="@color/pc_secondaryContainer"
    app:strokeColor="@color/pc_outlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/roomIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/sage_ic_room_default"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/textViewRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/pc_onSurface"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/textViewPlantCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/pc_onSecondaryContainer"
            android:fontFamily="@font/inter"
            android:background="@drawable/sage_bg_count_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minWidth="64dp"
            android:gravity="center"
            tools:text="4 Pflanzen" />

        <ImageView
            android:id="@+id/dragHandle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="6dp"
            android:src="@drawable/ic_drag_handle"
            android:contentDescription="@string/drag_handle_cd" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
