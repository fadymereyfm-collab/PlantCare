<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/journalToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/journal_title"
            app:titleTextAppearance="@style/TextAppearance.PlantCare.Title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="96dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/journalSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/pc_surface"
                    app:strokeColor="@color/pc_outlineVariant"
                    app:strokeWidth="1dp"
                    app:contentPadding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/journalPlantName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceHeadline6"
                            android:textStyle="bold"
                            android:textColor="@color/pc_onSurface"
                            tools:text="Einblatt · Wohnzimmer" />

                        <TextView
                            android:id="@+id/journalSinceLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceBody1"
                            android:textColor="@color/pc_onSurfaceSecondary"
                            tools:text="Seit 15.01.2025 (471 Tage)" />

                        <TextView
                            android:id="@+id/journalCounters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="?attr/textAppearanceSubtitle1"
                            android:textStyle="bold"
                            android:textColor="@color/pc_onSurface"
                            tools:text="47 Gießungen · 18 Fotos · 3 Checks" />

                        <TextView
                            android:id="@+id/journalMemoCounter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBody1"
                            android:textColor="@color/pc_onSurfaceSecondary"
                            android:visibility="gone"
                            tools:text="5 Notizen"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/journalLastWateringLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textColor="@color/pc_onSurfaceSecondary"
                            tools:text="Zuletzt gegossen: 2026-04-27" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/journalFilterChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleLine="false"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/journalChipAll"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/journal_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/journalChipWatering"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/journal_filter_watering" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/journalChipPhotos"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/journal_filter_photos" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/journalChipDiagnoses"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/journal_filter_diagnoses" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/journalChipMemos"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/journal_filter_memos" />
                </com.google.android.material.chip.ChipGroup>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/journalRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/journalEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/journal_empty"
                    android:textAppearance="@style/TextAppearance.PlantCare.Body"
                    android:textColor="@color/pc_onSurfaceSecondary"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/journalAddMemoFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/journal_add_memo_fab_desc"
        app:srcCompat="@drawable/ic_add" />
</FrameLayout>
