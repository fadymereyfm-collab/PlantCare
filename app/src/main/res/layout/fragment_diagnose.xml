<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare - fragment_diagnose (Phase G6.2 - full landing).

    Replaces the G1.5 skeleton. Top-down structure:
        1. Hero card        - title + subtitle + Pill CTA + 3D microscope
                              illustration. Background pc_primaryContainer.
        2. Recent section   - title TextView + RecyclerView (last 5
                              diagnoses).
        3. Empty state      - 3D pot inside brackets + title + body when
                              the user has no diagnoses yet.

    IDs (DiagnoseFragment.kt binds these):
        startDiagnoseBtn        - Hero CTA, opens DiseaseDiagnosisActivity.
        recentDiagnosesRv       - last-5 list (LinearLayoutManager vertical).
        recentDiagnosesSection  - title + RV container (hidden when empty).
        emptyDiagnoseContainer  - brackets + 3D pot + texts (hidden when has data).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- ═════════════ 1) Hero card ═════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/pc_primaryContainer"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:padding="20dp">

                <TextView
                    android:id="@+id/diagnoseHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnose_landing_title"
                    android:textAppearance="@style/TextAppearance.PlantCare.Title"
                    android:textSize="22sp"
                    android:textColor="@color/pc_onPrimaryContainer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/diagnoseHeroImage" />

                <TextView
                    android:id="@+id/diagnoseHeroSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/diagnose_landing_subtitle"
                    android:textAppearance="@style/TextAppearance.PlantCare.Body"
                    android:textSize="13sp"
                    android:textColor="@color/pc_onPrimaryContainer"
                    android:alpha="0.85"
                    app:layout_constraintTop_toBottomOf="@id/diagnoseHeroTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/diagnoseHeroImage" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startDiagnoseBtn"
                    style="@style/PlantCare.Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/diagnose_landing_cta"
                    android:backgroundTint="@color/pc_surface"
                    android:textColor="@color/pc_on_surface_strong"
                    android:minHeight="44dp"
                    app:icon="@drawable/ic_nav_diagnose"
                    app:iconTint="@color/pc_on_surface_strong"
                    app:iconGravity="textStart"
                    app:layout_constraintTop_toBottomOf="@id/diagnoseHeroSubtitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/diagnoseHeroImage"
                    android:layout_width="124dp"
                    android:layout_height="140dp"
                    android:src="@drawable/diagnose_3d_microscope"
                    android:scaleType="fitEnd"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═════════════ 2) Recent diagnoses section ═════════════ -->
        <LinearLayout
            android:id="@+id/recentDiagnosesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/diagnose_recent_section"
                    android:textAppearance="@style/TextAppearance.PlantCare.Title"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/seeAllDiagnoses"
                    style="@style/PlantCare.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnose_see_all"
                    android:textColor="@color/pc_primary"
                    android:layout_marginEnd="-8dp"
                    app:icon="@drawable/ic_calendar_arrow"
                    app:iconTint="@color/pc_primary"
                    app:iconGravity="end"
                    app:iconSize="18dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentDiagnosesRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false" />

        </LinearLayout>

        <!-- ═════════════ 3) Empty state ═════════════ -->
        <LinearLayout
            android:id="@+id/emptyDiagnoseContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:src="@drawable/ic_brackets_tl"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:src="@drawable/ic_brackets_tr"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|start"
                    android:src="@drawable/ic_brackets_bl"
                    android:contentDescription="@null" />
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_brackets_br"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:src="@drawable/empty_diagnose_3d"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/diagnose_empty_title"
                android:textAppearance="@style/TextAppearance.PlantCare.Title"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:gravity="center"
                android:text="@string/diagnose_empty_subtitle"
                android:textAppearance="@style/TextAppearance.PlantCare.Body"
                android:textColor="@color/pc_onSurfaceSecondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
