<?xml version="1.0" encoding="utf-8"?>
<!--
    PlantCare — item_today_room_header (F4.3 — visual redesign)

    Group header inside TodayFragment's RecyclerView. Sits ABOVE a
    cluster of `item_daily_watering` rows that belong to the same room.

    Visual: small uppercase section label (sage / on-surface-secondary)
    + room name in DM Serif. Mirrors the SettingsSectionLabel pattern
    used elsewhere in F2/F3 so the visual language is consistent.

    Identifier preserved: textRoomHeader.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roomHeaderContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="20dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/textRoomHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.PlantCare.Subtitle"
        android:textSize="17sp"
        tools:ignore="HardcodedText"
        tools:text="Wohnzimmer"
        xmlns:tools="http://schemas.android.com/tools" />

</LinearLayout>
