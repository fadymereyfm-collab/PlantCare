<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_background">

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/my_garden_header_title"
        android:textAppearance="@style/TextAppearance.PlantCare.Headline"
        android:textSize="28sp"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/headerSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/my_garden_header_subtitle"
        android:textAppearance="@style/TextAppearance.PlantCare.BodySmall"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/sectionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/my_rooms_section"
        android:textAppearance="@style/TextAppearance.PlantCare.Title"
        android:textSize="18sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- UI-BUG-7 round 2 (2026-05-17): RecyclerView ends at fabAddPlant.top
         so the last room card never sits under any floating element. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRooms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toBottomOf="@id/sectionLabel"
        app:layout_constraintBottom_toTopOf="@id/fabAddPlant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- UI-BUG-7 round 2 (2026-05-17): the previous floating ExtendedFAB
         sat on top of the Toilette row in default seed data — padding +
         elevation tweaks moved the *scroll boundary* but not the FAB
         itself, so the visual overlap remained. Replaced with a normal
         full-width MaterialButton stacked above btnAddRoom. Same id =>
         MyPlantsFragment.java:113 binding is unchanged (uses View ref).
         Hierarchy: rooms ↑ primary green Pflanze ↑ tonal Zimmer ↑ bottom. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabAddPlant"
        style="@style/PlantCare.Button.Filled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/add_plant_fab"
        android:contentDescription="@string/add_plant_fab"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/pc_onPrimary"
        app:iconGravity="textStart"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/btnAddRoom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddRoom"
        style="@style/PlantCare.Button.Tonal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/add_room_cta"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/pc_onSecondaryContainer"
        app:iconGravity="textStart"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
