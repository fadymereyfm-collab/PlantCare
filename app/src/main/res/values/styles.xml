<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Button.Primary" parent="PlantCare.Button.Filled" />

    <style name="Button.Secondary" parent="PlantCare.Button.Outlined" />

    <style name="Card.Rounded" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:background">@color/card_bg</item>
    </style>

    <style name="Dialog.Modern" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:background">@color/card_bg</item>
        <item name="android:windowBackground">@color/card_bg</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="shapeAppearanceOverlay">@style/DialogShapeAppearance</item>
        <item name="android:elevation">4dp</item>
        <item name="android:padding">28dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="materialButtonStyle">@style/PlantCare.Button.Outlined</item>
    </style>

    <style name="DialogShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.PlantCare.IdentifyThumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.PlantCare.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThemeOverlay.PlantCare.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="materialCalendarStyle">@style/PlantCareMaterialCalendar</item>
        <item name="materialCalendarTheme">@style/PlantCareMaterialCalendar</item>
        <item name="materialButtonStyle">@style/PlantCare.Button.Outlined</item>
    </style>

    <style name="PlantCareMaterialCalendar" parent="Widget.MaterialComponents.MaterialCalendar">
        <item name="android:background">@color/card_bg</item>
        <item name="shapeAppearanceOverlay">@style/DialogShapeAppearance</item>
        <item name="daySelectedStyle">@style/DaySelectedStyle</item>
    </style>

    <style name="DaySelectedStyle" parent="Widget.MaterialComponents.MaterialCalendar.Day.Selected">
        <item name="itemShapeAppearanceOverlay">@style/DialogShapeAppearance</item>
        <item name="android:background">@color/pc_primary</item>
    </style>

    <!-- ============================================================
         SettingsFragment shared styles (Phase G7 polish).
         ============================================================ -->
    <style name="SettingsSectionLabel" parent="TextAppearance.PlantCare.SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/pc_surface_translucent</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/pc_outlineVariant</item>
    </style>

    <style name="SettingsCardInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="SettingsRowIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/bg_settings_icon_tile</item>
        <item name="tint">@color/pc_onSurface</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsRowTitle" parent="TextAppearance.PlantCare.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pc_onSurface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsRowSubtitle" parent="TextAppearance.PlantCare.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/pc_onSurfaceSecondary</item>
    </style>

    <style name="SettingsRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">60dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@color/pc_background_dim</item>
        <item name="android:alpha">0.6</item>
    </style>

    <style name="ShapeAppearance.PlantCare.RoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.PlantCare.LargeRoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="PlantDetails.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="PlantDetails.Value">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pc_onSurface</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="PlantDetails" />

</resources>
