    <!-- 2026-05-20 Feature 1 (Crop): Theme for com.yalantis.ucrop.UCropActivity.
         Note: uCrop 2.2.9 does NOT declare ucrop_color_* names as theme
         attributes — they exist only as <color> resources in the library's
         colors.xml. Trying to set them inside a <style> trips AAPT
         ("attribute ucrop_color_toolbar not found"). We therefore rely on
         the runtime UCrop.Options API (setToolbarColor / setStatusBarColor
         / setActiveControlsWidgetColor / setToolbarWidgetColor) wired in
         UnifiedCameraActivity.launchUCrop. Standard Android attrs below
         still flow through because uCrop reads them via the inflated
         Toolbar + system. -->
    <style name="Theme.PlantCare.Crop" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/pc_primary</item>
        <item name="colorPrimaryDark">@color/pc_primary</item>
        <item name="colorAccent">@color/pc_primary</item>
        <item name="android:colorAccent">@color/pc_primary</item>
        <item name="android:textColorPrimary">@color/pc_onSurface</item>
        <item name="android:textColorSecondary">@color/pc_onSurfaceSecondary</item>
        <item name="android:windowBackground">@color/pc_surface</item>
        <item name="android:statusBarColor">@color/pc_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>
</resources>
