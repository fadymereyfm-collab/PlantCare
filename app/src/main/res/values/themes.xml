    <!-- G-typography-fix (2026-05-17): card corner trimmed 24dp → 18dp
         to match the tightened Card shape in shapes.xml and read less chunky. -->
    <!-- G-PRO-1 (2026-05-17): added cardElevation 0dp → 1dp.
         The reference apps (Plant Identifier, Set care reminders) read as
         "premium" because every meaningful surface sits ~1-3dp above its
         background with a soft shadow. PlantCare's stroke-only flat cards
         were the single biggest "looks like a 2014 Material 1.0 demo" tell.
         Stroke kept at 1dp so flat-mode rendering still has definition. -->
    <style name="PlantCare.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/pc_surface</item>
        <item name="contentPadding">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/pc_outlineVariant</item>
    </style>

