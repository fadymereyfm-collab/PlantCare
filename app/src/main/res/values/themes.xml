    <!-- Phase G1.3 — Bottom Navigation active-pill indicator -->
    <!-- 2026-05-17 UI-BUG-5: width 64dp was wider than the per-tab cell on
         ~360dp screens (5 tabs × ~70dp each), causing the pill to appear
         off-centre around the icon. 48dp×32dp tracks Material 3 spec and
         hugs the icon glyph tightly. -->
    <style name="PlantCare.BottomNav.ActiveIndicator" parent="">
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
        <item name="android:color">@color/pc_primaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PlantCare.Pill</item>
