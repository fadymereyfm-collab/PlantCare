    <!-- Room icon palette (12 distinct hues) -->
    <!-- 2026-05-17 UI-BUG-8: distinct per-room palette (cohesive saturation,
         AA-safe against the white foreground icon in sage_ic_room_*).
         Reverts the G-polish-3 sage unification that made every room read
         identically — Fady's emulator pass showed 6 indistinguishable cards.

         2026-05-18 contrast audit (white icon foreground):
         5 of the 12 colours failed the WCAG AA 3:1 threshold for large UI
         glyphs — kitchen #F2A93B was the worst at 2.00. Darkened those 5
         to the lightest variant that crosses 3.0 contrast so the white
         icon stays visible on every card. The other 7 already passed and
         are unchanged (saturation intent preserved). -->
    <color name="room_living">#E07856</color>     <!-- terracotta · 3.00 (warm/social) -->
    <color name="room_bedroom">#6A8FBF</color>    <!-- soft denim · 3.34 (restful) -->
    <color name="room_bathroom">#2A92A0</color>   <!-- deeper teal · 3.67 (water/fresh — was #4FB3BF / 2.46) -->
    <color name="room_toilet">#7E96A8</color>     <!-- slate · 3.08 (neutral utility) -->
    <color name="room_hallway">#9C7A45</color>    <!-- deeper caramel · 3.97 (warm transit — was #B9925D / 2.86) -->
